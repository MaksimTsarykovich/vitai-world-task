# Переменные окружения без секретов. Скопируйте в .env (он в .gitignore).
#
# База: SQLite-совместимая, через @libsql/client.
#   локально  — file:./data/kvarta.db
#   Docker    — file:/data/kvarta.db (том /data)
#   Vercel    — libsql://<база>.turso.io (+ токен ниже)
DATABASE_URL=file:./data/kvarta.db

# Токен Turso. Нужен только для libsql:// (Vercel); для локального файла пустой.
DATABASE_AUTH_TOKEN=

# Публичный адрес сайта: используется в canonical, OG, robots и sitemap.
# На деплое обязателен, локально по умолчанию http://localhost:3000.
SITE_URL=http://localhost:3000

# Порт приложения.
PORT=3000

# POST /api/lead: лимит запросов с одного IP в минуту (окно 1 минута).
LEAD_RATE_LIMIT=20

# Доверять X-Forwarded-For: 1 — за Caddy на VPS и на Vercel, 0 — напрямую.
TRUST_PROXY=0

# Дубль заявки в Telegram — необязательный плюс. Включается, только когда
# заданы оба значения. Оставьте пустыми, чтобы выключить.
# Токен выдаёт @BotFather, chat_id — id чата или канала (например, -100…).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

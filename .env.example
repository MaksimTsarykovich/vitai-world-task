# Переменные окружения без секретов. Скопируйте в .env (он в .gitignore).
#
# Путь к файлу SQLite. Локально — относительный, в Docker — том /data.
DATABASE_PATH=./data/kvarta.db

# Публичный адрес сайта: используется в canonical, OG и sitemap. На деплое обязателен.
SITE_URL=http://localhost:3000

# Порт приложения.
PORT=3000

# POST /api/lead: лимит запросов с одного IP в минуту (окно 1 минута).
LEAD_RATE_LIMIT=20

# Доверять X-Forwarded-For только за своим reverse proxy (Caddy). 0 или 1.
TRUST_PROXY=0
